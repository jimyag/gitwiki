{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "Vite",
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "groupName": "Go"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "extractVersion": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["gopkg.in/yaml.v2"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
